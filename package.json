{
  "name": "mycelium",
  "private": true,
  "version": "0.1.0",
  "description": "Self-growing, self-healing web data collection network. Built on Bright Data Scraper Studio for Into the Scrape-Verse 2026.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "orchestrate": "tsx packages/orchestrator/src/main.ts",
    "api": "tsx apps/api/src/main.ts",
    "check": "tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
